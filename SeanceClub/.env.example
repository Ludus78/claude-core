# Base de données (docker-compose.yml)
DATABASE_URL=postgres://seance:seance@localhost:5432/seanceclub
REDIS_URL=redis://localhost:6379

# Kinde (même stack que immonova) : application « SeanceClub » à créer dans Kinde,
# fournisseurs Google et Discord activés côté Kinde (aucune clé Google/Discord ici).
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
KINDE_ISSUER_URL=
KINDE_SITE_URL=http://localhost:3000
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000

# API de films (TMDB) : licence commerciale à obtenir avant le premium
TMDB_API_KEY=
